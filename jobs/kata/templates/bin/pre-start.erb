#!/usr/bin/env bash
# Prepares the host for garden's VM runtime mode with Kata Containers.
set -euo pipefail

JOB_DIR=/var/vcap/jobs/kata
PKG_DIR=/var/vcap/packages/kata
SHARE=/opt/kata/share/defaults/kata-containers
MARKER=.managed-by-bosh-kata-job

log() { echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) kata pre-start: $*"; }

CONFIG_DIR=/etc/kata-containers/runtime-rs
BASE_CONFIG="${SHARE}/runtime-rs/configuration-clh-runtime-rs.toml"

# Only remove what this job installed (marker file next to the configuration).
remove_managed_config() {
  if [ -f "${CONFIG_DIR}/${MARKER}" ]; then
    rm -f "${CONFIG_DIR}/configuration.toml" "${CONFIG_DIR}/config.d/10-garden.toml" "${CONFIG_DIR}/${MARKER}"
    log "removed managed configuration in ${CONFIG_DIR}"
  fi
}

<% unless p("kata.enabled") -%>
remove_managed_config
if [ -L /opt/kata ] && [[ "$(readlink /opt/kata)" == "${PKG_DIR}"* ]]; then
  rm -f /opt/kata
fi
log "kata.enabled is false, nothing to do"
exit 0
<% end -%>

# 1. Hardware virtualization.
if [ ! -c /dev/kvm ]; then
  log "ERROR: /dev/kvm not found. The VM type must support (nested) hardware virtualization."
  exit 1
fi

# 2. Device access contract of the rootless VMM (Kata docs: how-to-run-rootless-vmm): a character device
#    granting read and write through a group other than root. Persist it with a udev rule.
getent group kvm >/dev/null || groupadd --system kvm
chgrp kvm /dev/kvm
chmod 0660 /dev/kvm
echo 'KERNEL=="kvm", SUBSYSTEM=="misc", GROUP="kvm", MODE="0660"' > /etc/udev/rules.d/99-kata-kvm.rules

# 3. Kata's shipped configurations and binaries reference /opt/kata.
if [ -e /opt/kata ] && [ ! -L /opt/kata ]; then
  log "ERROR: /opt/kata exists and is not a symlink, refusing to replace it"
  exit 1
fi
ln -sfn "${PKG_DIR}/opt/kata" /opt/kata

# 4. Configuration: Kata's shipped runtime-rs Cloud Hypervisor configuration plus our drop-in (Kata merges
#    config.d/*.toml next to the base file). The base file is copied so it follows package upgrades.
if [ ! -f "${BASE_CONFIG}" ]; then
  log "ERROR: ${BASE_CONFIG} not found in the kata package"
  exit 1
fi
mkdir -p "${CONFIG_DIR}/config.d"
rm -f "${CONFIG_DIR}/configuration.toml"
install -m 0644 "${BASE_CONFIG}" "${CONFIG_DIR}/configuration.toml"
install -m 0644 "${JOB_DIR}/config/10-garden.toml" "${CONFIG_DIR}/config.d/10-garden.toml"
touch "${CONFIG_DIR}/${MARKER}"

<% if p("kata.rootless") -%>
# 5. The runtime-rs shim creates (useradd) and removes (userdel) one VMM user per sandbox.
for tool in useradd userdel nologin; do
  if ! command -v "${tool}" >/dev/null 2>&1 && [ ! -x "/usr/sbin/${tool}" ]; then
    log "ERROR: ${tool} not found, required by the rootless VMM"
    exit 1
  fi
done
<% end -%>

log "installed kata $(cat ${PKG_DIR}/VERSION 2>/dev/null || echo unknown) rootless=<%= p("kata.rootless") %> guest_seccomp=<%= p("kata.guest_seccomp") %> config=${CONFIG_DIR}/configuration.toml"
