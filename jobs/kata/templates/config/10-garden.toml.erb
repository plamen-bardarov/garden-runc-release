# Generated by the garden-runc-release kata job. Merged on top of Kata's shipped
# runtime-rs/configuration-clh-runtime-rs.toml (drop-in, see Kata docs: config.d).

[hypervisor.clh]
default_vcpus = <%= Integer(p("kata.default_vcpus")) %>
default_memory = <%= Integer(p("kata.default_memory_mb")) %>
virtio_fs_extra_args = [<%= p("kata.virtio_fs_extra_args").map { |a| %Q("#{a}") }.join(", ") %>]
enable_debug = <%= p("kata.debug") %>
rootless = <%= p("kata.rootless") %>

[agent.kata]
enable_debug = <%= p("kata.debug") %>
debug_console_enabled = <%= p("kata.debug_console") %>

[runtime]
enable_debug = <%= p("kata.debug") %>
enable_pprof = <%= p("kata.pprof") %>
disable_guest_seccomp = <%= !p("kata.guest_seccomp") %>
# garden puts the whole sandbox (VMM, virtiofsd, shim) into the container's cgroup
sandbox_cgroup_only = true
